{
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(node tools/trace-check/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh repo create *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-locked-paths.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/run-fast-tests.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
