{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:api": "openapi-generator-cli generate -i ../contracts/openapi.yaml -g typescript-angular -o src/app/api --additional-properties=ngVersion=21.0.0,fileNaming=kebab-case",
    "prestart": "npm run generate:api",
    "start": "ng serve",
    "prebuild": "npm run generate:api",
    "build": "ng build",
    "pretest": "npm run generate:api",
    "test": "ng test",
    "test:ui": "npm run generate:api && tsc --noEmit -p e2e/tsconfig.json && bddgen && playwright test"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.0",
    "@openapitools/openapi-generator-cli": "^2.42.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "jsdom": "^28.0.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
